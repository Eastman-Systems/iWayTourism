---
import BaseLayout from '../components/layout/BaseLayout.astro';
import HeroSection from '../components/content/HeroSection.astro';
import TestimonialCard from '../components/content/TestimonialCard.astro';

const fmtPrice = (n: number) => new Intl.NumberFormat('en-IN', { style: 'currency', currency: 'INR', maximumFractionDigits: 0 }).format(n);
import { getEntry } from 'astro:content';

const entry = await getEntry('core', 'homepage');
if (!entry || entry.data.pageType !== 'homepage') throw new Error('Missing content: core/homepage.json');
const { seo, hero, trustBadges, localToursPreview, internationalToursPreview, fleetPreview, featuredTestimonials, ctaSection } = entry.data;
---

<BaseLayout seo={seo} preloadImage={hero.image}>
  <HeroSection heading={hero.heading} subheading={hero.subheading} image={hero.image} imageAlt={hero.imageAlt}>
    <a href="/contact" class="mt-6 inline-block rounded-lg bg-amber-500 px-6 py-3 text-sm font-semibold text-slate-900 transition-colors hover:bg-amber-400">
      Get a Free Quote
    </a>
  </HeroSection>

  <!-- Trust Badges -->
  <section class="bg-teal-50 py-8 sm:py-10">
    <div class="mx-auto max-w-7xl px-4 sm:px-6 lg:px-8">
      <div class="flex flex-col items-start gap-4 sm:flex-row sm:flex-wrap sm:items-center sm:justify-center sm:gap-6">
        {trustBadges.map((badge) => (
          <div class="flex items-center gap-3 text-sm text-slate-800">
            {badge.icon === 'map-pin' && (
              <svg class="h-6 w-6 shrink-0 text-teal-600" fill="none" viewBox="0 0 24 24" stroke-width="1.5" stroke="currentColor" aria-hidden="true">
                <path stroke-linecap="round" stroke-linejoin="round" d="M15 10.5a3 3 0 1 1-6 0 3 3 0 0 1 6 0Z" />
                <path stroke-linecap="round" stroke-linejoin="round" d="M19.5 10.5c0 7.142-7.5 11.25-7.5 11.25S4.5 17.642 4.5 10.5a7.5 7.5 0 1 1 15 0Z" />
              </svg>
            )}
            {badge.icon === 'shield-check' && (
              <svg class="h-6 w-6 shrink-0 text-teal-600" fill="none" viewBox="0 0 24 24" stroke-width="1.5" stroke="currentColor" aria-hidden="true">
                <path stroke-linecap="round" stroke-linejoin="round" d="M9 12.75 11.25 15 15 9.75m-3-7.036A11.959 11.959 0 0 1 3.598 6 11.99 11.99 0 0 0 3 9.749c0 5.592 3.824 10.29 9 11.623 5.176-1.332 9-6.03 9-11.622 0-1.31-.21-2.571-.598-3.751h-.152c-3.196 0-6.1-1.248-8.25-3.285Z" />
              </svg>
            )}
            {badge.icon === 'plane' && (
              <svg class="h-6 w-6 shrink-0 text-teal-600" fill="none" viewBox="0 0 24 24" stroke-width="1.5" stroke="currentColor" aria-hidden="true">
                <path stroke-linecap="round" stroke-linejoin="round" d="M6 12 3.269 3.125A59.769 59.769 0 0 1 21.485 12 59.768 59.768 0 0 1 3.27 20.875L5.999 12Zm0 0h7.5" />
              </svg>
            )}
            {badge.icon === 'users' && (
              <svg class="h-6 w-6 shrink-0 text-teal-600" fill="none" viewBox="0 0 24 24" stroke-width="1.5" stroke="currentColor" aria-hidden="true">
                <path stroke-linecap="round" stroke-linejoin="round" d="M15 19.128a9.38 9.38 0 0 0 2.625.372 9.337 9.337 0 0 0 4.121-.952 4.125 4.125 0 0 0-7.533-2.493M15 19.128v-.003c0-1.113-.285-2.16-.786-3.07M15 19.128v.106A12.318 12.318 0 0 1 8.624 21c-2.331 0-4.512-.645-6.374-1.766l-.001-.109a6.375 6.375 0 0 1 11.964-3.07M12 6.375a3.375 3.375 0 1 1-6.75 0 3.375 3.375 0 0 1 6.75 0Zm8.25 2.25a2.625 2.625 0 1 1-5.25 0 2.625 2.625 0 0 1 5.25 0Z" />
              </svg>
            )}
            {badge.icon === 'headset' && (
              <svg class="h-6 w-6 shrink-0 text-teal-600" fill="none" viewBox="0 0 24 24" stroke-width="1.5" stroke="currentColor" aria-hidden="true">
                <path stroke-linecap="round" stroke-linejoin="round" d="M12 18.75a6 6 0 0 0 6-6v-1.5m-6 7.5a6 6 0 0 1-6-6v-1.5m6 7.5v3.75m-3.75 0h7.5M12 15.75a3 3 0 0 1-3-3V4.5a3 3 0 1 1 6 0v8.25a3 3 0 0 1-3 3Z" />
              </svg>
            )}
            <span>{badge.label}</span>
          </div>
        ))}
      </div>
    </div>
  </section>

  <!-- International Tours Preview -->
  <section class="bg-white py-16 sm:py-20 lg:py-24">
    <div class="mx-auto max-w-7xl px-4 sm:px-6 lg:px-8">
      <h2 class="font-heading text-2xl font-semibold text-slate-900">{internationalToursPreview.heading}</h2>
      <p class="mt-2 max-w-3xl text-slate-600">{internationalToursPreview.subheading}</p>
      <div class="mt-8 grid gap-4 sm:grid-cols-2 sm:gap-6 lg:grid-cols-4">
        {internationalToursPreview.featured.map((pkg) => (
          <a href={`/international-tours/${pkg.slug}`} class="group overflow-hidden rounded-xl border border-slate-100 bg-white shadow-sm transition-shadow duration-200 hover:shadow-md">
            <img src={pkg.image} alt={pkg.imageAlt} width="600" height="338" loading="lazy" class="aspect-video w-full rounded-t-xl object-cover" />
            <div class="p-5 sm:p-6">
              <h3 class="font-heading text-lg font-semibold text-slate-900">{pkg.title}</h3>
              <p class="mt-2 text-sm text-slate-600">{pkg.tagline}</p>
              <span class="mt-3 inline-block rounded-full bg-amber-50 px-3 py-1 text-sm font-semibold text-amber-700">
                From {fmtPrice(pkg.priceFrom)}
              </span>
            </div>
          </a>
        ))}
      </div>
      <div class="mt-8 text-center">
        <a href="/international-tours" class="inline-flex items-center gap-2 rounded-lg border border-teal-200 px-5 py-2.5 font-semibold text-teal-700 transition-colors hover:bg-teal-50 hover:text-teal-900">
          View all international packages
          <svg class="h-4 w-4" fill="none" viewBox="0 0 24 24" stroke-width="2" stroke="currentColor" aria-hidden="true"><path stroke-linecap="round" stroke-linejoin="round" d="M8.25 4.5l7.5 7.5-7.5 7.5" /></svg>
        </a>
      </div>
    </div>
  </section>

  <!-- Local Tours Preview -->
  <section class="bg-slate-50 py-16 sm:py-20 lg:py-24">
    <div class="mx-auto max-w-7xl px-4 sm:px-6 lg:px-8">
      <h2 class="font-heading text-2xl font-semibold text-slate-900">{localToursPreview.heading}</h2>
      <p class="mt-2 max-w-3xl text-slate-600">{localToursPreview.subheading}</p>
      <div class="mt-8 grid gap-4 sm:grid-cols-2 sm:gap-6 lg:grid-cols-3">
        {localToursPreview.featured.map((tour) => (
          <a href={`/local-tours/${tour.slug}`} class="group overflow-hidden rounded-xl border border-slate-100 bg-white shadow-sm transition-shadow duration-200 hover:shadow-md">
            <img src={tour.image} alt={tour.imageAlt} width="600" height="338" loading="lazy" class="aspect-video w-full rounded-t-xl object-cover" />
            <div class="p-5 sm:p-6">
              <h3 class="font-heading text-lg font-semibold text-slate-900">{tour.title}</h3>
              <p class="mt-2 text-sm text-slate-600">{tour.tagline}</p>
            </div>
          </a>
        ))}
      </div>
      <div class="mt-8 text-center">
        <a href="/local-tours" class="inline-flex items-center gap-2 rounded-lg border border-teal-200 px-5 py-2.5 font-semibold text-teal-700 transition-colors hover:bg-teal-50 hover:text-teal-900">
          View all local tours
          <svg class="h-4 w-4" fill="none" viewBox="0 0 24 24" stroke-width="2" stroke="currentColor" aria-hidden="true"><path stroke-linecap="round" stroke-linejoin="round" d="M8.25 4.5l7.5 7.5-7.5 7.5" /></svg>
        </a>
      </div>
    </div>
  </section>

  <!-- Fleet Preview -->
  <section class="bg-white py-16 sm:py-20 lg:py-24">
    <div class="mx-auto max-w-7xl px-4 sm:px-6 lg:px-8">
      <h2 class="font-heading text-2xl font-semibold text-slate-900">{fleetPreview.heading}</h2>
      <p class="mt-2 max-w-3xl text-slate-600">{fleetPreview.subheading}</p>
      <div class="mt-8 grid gap-4 sm:grid-cols-2 sm:gap-6 lg:grid-cols-3">
        {fleetPreview.featured.map((vehicle) => (
          <a href="/cab-rental-fleet" class="group overflow-hidden rounded-xl border border-slate-100 bg-white shadow-sm transition-shadow duration-200 hover:shadow-md">
            <img src={vehicle.image} alt={vehicle.imageAlt} width="600" height="338" loading="lazy" class="aspect-video w-full rounded-t-xl object-cover" />
            <div class="p-5 sm:p-6">
              <h3 class="font-heading text-lg font-semibold text-slate-900">{vehicle.name}</h3>
              <p class="mt-2 text-sm text-slate-600">{vehicle.capacity} Seats</p>
            </div>
          </a>
        ))}
      </div>
      <div class="mt-8 text-center">
        <a href="/cab-rental-fleet" class="inline-flex items-center gap-2 rounded-lg border border-teal-200 px-5 py-2.5 font-semibold text-teal-700 transition-colors hover:bg-teal-50 hover:text-teal-900">
          View full fleet
          <svg class="h-4 w-4" fill="none" viewBox="0 0 24 24" stroke-width="2" stroke="currentColor" aria-hidden="true"><path stroke-linecap="round" stroke-linejoin="round" d="M8.25 4.5l7.5 7.5-7.5 7.5" /></svg>
        </a>
      </div>
    </div>
  </section>

  <!-- Testimonials -->
  <section class="bg-slate-50 py-16 sm:py-20 lg:py-24">
    <div class="mx-auto max-w-7xl px-4 sm:px-6 lg:px-8">
      <h2 class="font-heading text-2xl font-semibold text-slate-900">What Our Travellers Say</h2>
      <div class="mt-8 grid gap-6 sm:grid-cols-2 lg:grid-cols-3">
        {featuredTestimonials.map((testimonial) => (
          <TestimonialCard {...testimonial} />
        ))}
      </div>
      <div class="mt-6">
        <a href="/reviews" class="text-sm font-medium text-teal-700 hover:text-teal-900">
          Read all reviews &rarr;
        </a>
      </div>
    </div>
  </section>

  <!-- CTA -->
  <section class="bg-teal-700 py-16 sm:py-20 lg:py-24">
    <div class="mx-auto max-w-7xl px-4 text-center sm:px-6 lg:px-8">
      <h2 class="font-heading text-2xl font-semibold text-white">{ctaSection.heading}</h2>
      <p class="mx-auto mt-3 max-w-2xl text-teal-100">{ctaSection.body}</p>
      <a
        href={ctaSection.buttonUrl}
        class="mt-6 inline-block rounded-lg bg-amber-500 px-8 py-3 text-sm font-semibold text-slate-900 transition-colors hover:bg-amber-400"
      >
        {ctaSection.buttonText}
      </a>
    </div>
  </section>
</BaseLayout>
