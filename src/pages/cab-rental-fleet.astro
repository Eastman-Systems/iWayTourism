---
import BaseLayout from '../components/layout/BaseLayout.astro';
import HeroSection from '../components/content/HeroSection.astro';
import SchemaBlock from '../components/schema/SchemaBlock.astro';
import QuickAnswer from '../components/content/QuickAnswer.astro';
import VehicleCard from '../components/content/VehicleCard.astro';
import FAQAccordion from '../components/content/FAQAccordion.astro';
import { getEntry } from 'astro:content';
import { buildOfferCatalogSchema } from '../utils/schema-builder';

const entry = await getEntry('core', 'fleet');
if (!entry || entry.data.pageType !== 'fleet') throw new Error('Missing content: core/fleet.json');
const { seo, hero, quickAnswer, vehicles, bookingProcess, faqs } = entry.data;

const catalogSchema = buildOfferCatalogSchema(vehicles);
---

<BaseLayout seo={seo}>
  <SchemaBlock schema={catalogSchema} />

  <HeroSection heading={hero.heading} subheading={hero.subheading} image={hero.image} imageAlt={hero.imageAlt} />

  <div class="mx-auto max-w-7xl px-4 py-12 sm:px-6 lg:px-8">
    <QuickAnswer question={quickAnswer.question} answer={quickAnswer.answer} />

    <!-- Vehicles -->
    <section class="mt-12">
      <div class="flex flex-col gap-8">
        {vehicles.map((vehicle) => (
          <VehicleCard {...vehicle} />
        ))}
      </div>
    </section>

    <!-- Booking Process -->
    <section class="mt-16">
      <h2 class="font-heading text-2xl font-semibold text-slate-900">{bookingProcess.heading}</h2>
      <div class="mt-8 grid gap-6 sm:grid-cols-2 lg:grid-cols-3">
        {bookingProcess.steps.map((step) => (
          <div class="rounded-xl border border-slate-200 p-6">
            <span class="flex h-8 w-8 items-center justify-center rounded-full bg-primary text-sm font-bold text-white">
              {step.step}
            </span>
            <h3 class="mt-3 font-heading text-base font-semibold text-slate-900">{step.title}</h3>
            <p class="mt-2 text-sm leading-relaxed text-slate-600">{step.description}</p>
          </div>
        ))}
      </div>
    </section>

    <!-- FAQs -->
    {faqs && faqs.length > 0 && (
      <section class="mt-16">
        <h2 class="font-heading text-2xl font-semibold text-slate-900">Frequently Asked Questions</h2>
        <div class="mt-6">
          <FAQAccordion faqs={faqs} />
        </div>
      </section>
    )}
  </div>
</BaseLayout>
