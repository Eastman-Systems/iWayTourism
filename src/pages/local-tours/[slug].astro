---
import type { CollectionEntry } from 'astro:content';
import SiloLayout from '../../components/layout/SiloLayout.astro';
import HeroSection from '../../components/content/HeroSection.astro';
import SchemaBlock from '../../components/schema/SchemaBlock.astro';
import QuickAnswer from '../../components/content/QuickAnswer.astro';
import FAQAccordion from '../../components/content/FAQAccordion.astro';
import ItineraryDay from '../../components/content/ItineraryDay.astro';
import AttractionCard from '../../components/content/AttractionCard.astro';
import PracticalInfo from '../../components/content/PracticalInfo.astro';
import CrossSellCTA from '../../components/content/CrossSellCTA.astro';
import StickyFooterCTA from '../../components/conversion/StickyFooterCTA.astro';
import { getCollection } from 'astro:content';
import { buildArticleSchema, buildTouristTripSchema, buildHowToSchema, buildFAQPageSchema } from '../../utils/schema-builder';
import type { JsonLdSchema } from '../../utils/types';

export async function getStaticPaths() {
  const entries = await getCollection('local-tours');
  return entries
    .filter((entry) => entry.id !== '_pillar')
    .map((entry) => ({
      params: { slug: entry.id },
      props: { entry },
    }));
}

interface Props { entry: CollectionEntry<'local-tours'>; }
const { entry } = Astro.props as Props;
const data = entry.data;
const slug = entry.id;
const pageTitle = data.hero.heading;

// Narrowed type variables for template rendering
const itinerary = data.pageType === 'itinerary' ? data : null;
const sightseeing = data.pageType === 'sightseeing' ? data : null;
const editorial = data.pageType === 'editorial' ? data : null;
const faqPage = data.pageType === 'faq' ? data : null;

// Common optional properties across types
const author = itinerary?.author ?? sightseeing?.author ?? editorial?.author;
const overview = itinerary?.overview ?? sightseeing?.overview ?? editorial?.overview;
const practicalInfo = itinerary?.practicalInfo ?? sightseeing?.practicalInfo ?? editorial?.practicalInfo;
const crossSell = itinerary?.crossSell ?? sightseeing?.crossSell ?? editorial?.crossSell ?? faqPage?.crossSell;
const faqs = itinerary?.faqs ?? sightseeing?.faqs ?? editorial?.faqs;

// Build schemas
const schemas: JsonLdSchema[] = [];

if (itinerary) {
  schemas.push(buildArticleSchema({
    pageUrl: Astro.url.href, title: data.seo.title, description: data.seo.description,
    heroImage: data.hero.image, authorName: itinerary.author.name, authorRole: itinerary.author.role,
  }));
  schemas.push(buildHowToSchema({
    title: data.hero.heading, description: data.seo.description, heroImage: data.hero.image,
    pageUrl: Astro.url.href, totalDuration: 'P3D', days: itinerary.days,
  }));
}
if (sightseeing) {
  schemas.push(buildArticleSchema({
    pageUrl: Astro.url.href, title: data.seo.title, description: data.seo.description,
    heroImage: data.hero.image, authorName: sightseeing.author.name, authorRole: sightseeing.author.role,
  }));
  schemas.push(buildTouristTripSchema({
    name: data.hero.heading, description: data.seo.description, heroImage: data.hero.image,
    authorName: sightseeing.author.name, attractions: sightseeing.attractions,
  }));
}
if (editorial) {
  schemas.push(buildArticleSchema({
    pageUrl: Astro.url.href, title: data.seo.title, description: data.seo.description,
    heroImage: data.hero.image, authorName: editorial.author.name, authorRole: editorial.author.role,
  }));
}
if (faqPage) {
  const allFaqs = faqPage.faqGroups.flatMap((g) => g.faqs);
  schemas.push(buildFAQPageSchema(allFaqs));
}
---

<SiloLayout seo={data.seo} silo="local-tours" currentSlug={slug} pageTitle={pageTitle}>
  {schemas.map((schema) => <SchemaBlock schema={schema} />)}

  <HeroSection heading={data.hero.heading} subheading={data.hero.subheading} image={data.hero.image} imageAlt={data.hero.imageAlt} compact />

  <QuickAnswer question={data.quickAnswer.question} answer={data.quickAnswer.answer} />

  {author && <p class="mt-4 text-sm text-slate-500">By {author.name}, {author.role}</p>}
  {overview && <p class="mt-4 leading-relaxed text-slate-600">{overview}</p>}

  {/* Itinerary days */}
  {itinerary && (
    <section class="mt-10 flex flex-col gap-10">
      {itinerary.days.map((day) => <ItineraryDay {...day} />)}
    </section>
  )}

  {/* Sightseeing attractions */}
  {sightseeing && (
    <section class="mt-10 flex flex-col gap-8">
      {sightseeing.attractions.map((attraction) => <AttractionCard {...attraction} />)}
    </section>
  )}

  {/* Editorial sections */}
  {editorial && (
    <div class="mt-10 flex flex-col gap-10">
      {editorial.sections.map((section) => (
        <section>
          <h2 class="font-heading text-xl font-semibold text-slate-900">{section.heading}</h2>
          {section.quickAnswer && <QuickAnswer question={section.quickAnswer.question} answer={section.quickAnswer.answer} />}
          {section.body.map((p) => <p class="mt-3 leading-relaxed text-slate-600">{p}</p>)}
          {section.image && (
            <img src={section.image} alt={section.imageAlt ?? ''} width="800" height="450" loading="lazy" class="mt-4 aspect-video w-full rounded-lg object-cover" />
          )}
        </section>
      ))}
    </div>
  )}

  {/* FAQ groups */}
  {faqPage && (
    <div class="mt-10 flex flex-col gap-10">
      <p class="leading-relaxed text-slate-600">{faqPage.overview}</p>
      {faqPage.faqGroups.map((group) => (
        <section>
          <h2 class="font-heading text-xl font-semibold text-slate-900">{group.groupHeading}</h2>
          <div class="mt-4"><FAQAccordion faqs={group.faqs} /></div>
        </section>
      ))}
    </div>
  )}

  {practicalInfo && <div class="mt-10"><PracticalInfo info={practicalInfo} /></div>}

  {faqs && faqs.length > 0 && (
    <section class="mt-10">
      <h2 class="font-heading text-xl font-semibold text-slate-900">Frequently Asked Questions</h2>
      <div class="mt-4"><FAQAccordion faqs={faqs} /></div>
    </section>
  )}

  {crossSell && <div class="mt-10"><CrossSellCTA heading={crossSell.heading} body={crossSell.body} links={crossSell.links} /></div>}

  <StickyFooterCTA />
</SiloLayout>
