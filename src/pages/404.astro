---
import BaseLayout from '../components/layout/BaseLayout.astro';

const seo = {
  title: 'Page Not Found — iWay Tourism',
  description: 'The page you were looking for does not exist.',
  noindex: true,
};
---

<BaseLayout seo={seo}>
  <section class="mx-auto max-w-7xl px-4 py-24 text-center sm:px-6 lg:px-8">
    <p class="text-7xl font-bold text-slate-200">404</p>
    <h1 class="mt-4 font-heading text-xl font-semibold text-slate-900">Page Not Found</h1>
    <p class="mt-2 text-slate-600">The page you were looking for doesn't exist or has been moved.</p>
    <a
      href="/"
      class="mt-6 inline-block rounded-lg bg-primary px-6 py-3 text-sm font-medium text-white transition-colors hover:bg-primary-dark"
    >
      Back to Home
    </a>
  </section>
</BaseLayout>
