---
import BaseLayout from '../components/layout/BaseLayout.astro';
import HeroSection from '../components/content/HeroSection.astro';
import SchemaBlock from '../components/schema/SchemaBlock.astro';
import { getEntry } from 'astro:content';
import { buildWebPageSchema } from '../utils/schema-builder';

const entry = await getEntry('core', 'terms');
if (!entry || entry.data.pageType !== 'terms') throw new Error('Missing content: core/terms.json');
const { seo, hero, lastUpdated, sections } = entry.data;
const pageSchema = buildWebPageSchema({ title: seo.title, description: seo.description, pageUrl: Astro.url.href });
---

<BaseLayout seo={seo}>
  <SchemaBlock schema={pageSchema} />

  <HeroSection heading={hero.heading} subheading={hero.subheading} image={hero.image} imageAlt={hero.imageAlt} />

  <!-- Content -->
  <article class="mx-auto max-w-3xl px-4 py-12 sm:px-6 lg:px-8">
    <p class="mb-8 text-sm text-slate-500">Last updated: {lastUpdated}</p>
    {sections.map((section) => (
      <section class="mb-8">
        <h2 class="font-heading text-lg font-semibold text-slate-900">{section.heading}</h2>
        {section.content.map((paragraph) => (
          <p class="mt-3 text-sm leading-relaxed text-slate-600">{paragraph}</p>
        ))}
      </section>
    ))}
  </article>
</BaseLayout>
