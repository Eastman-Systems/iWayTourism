---
import type { CollectionEntry } from 'astro:content';
import SiloLayout from '../../components/layout/SiloLayout.astro';
import HeroSection from '../../components/content/HeroSection.astro';
import SchemaBlock from '../../components/schema/SchemaBlock.astro';
import QuickAnswer from '../../components/content/QuickAnswer.astro';
import FAQAccordion from '../../components/content/FAQAccordion.astro';
import PriceBadge from '../../components/content/PriceBadge.astro';
import HighlightsList from '../../components/content/HighlightsList.astro';
import StickyFooterCTA from '../../components/conversion/StickyFooterCTA.astro';
import { getCollection } from 'astro:content';
import { buildArticleSchema, buildProductOfferSchema, buildFAQPageSchema } from '../../utils/schema-builder';
import type { JsonLdSchema } from '../../utils/types';

export async function getStaticPaths() {
  const entries = await getCollection('international-tours');
  return entries
    .filter((entry) => entry.id !== '_pillar')
    .map((entry) => ({
      params: { slug: entry.id },
      props: { entry },
    }));
}

interface Props { entry: CollectionEntry<'international-tours'>; }
const { entry } = Astro.props as Props;
const data = entry.data;
const slug = entry.id;
const pageTitle = data.hero.heading;

// Narrowed type variables
const destination = data.pageType === 'destination' ? data : null;
const editorial = data.pageType === 'editorial' ? data : null;
const faqPage = data.pageType === 'faq' ? data : null;

// Build schemas
const schemas: JsonLdSchema[] = [];

if (destination) {
  schemas.push(buildProductOfferSchema({
    name: data.hero.heading, description: data.seo.description, heroImage: data.hero.image,
    pageUrl: Astro.url.href, tiers: destination.pricingTiers,
  }));
  schemas.push(buildArticleSchema({
    pageUrl: Astro.url.href, title: data.seo.title, description: data.seo.description,
    heroImage: data.hero.image, authorName: destination.author.name, authorRole: destination.author.role,
  }));
}
if (editorial) {
  schemas.push(buildArticleSchema({
    pageUrl: Astro.url.href, title: data.seo.title, description: data.seo.description,
    heroImage: data.hero.image, authorName: editorial.author.name, authorRole: editorial.author.role,
  }));
}
if (faqPage) {
  schemas.push(buildFAQPageSchema(faqPage.faqGroups.flatMap((g) => g.faqs)));
}

const pageFaqs = destination?.faqs ?? editorial?.faqs ?? [];
if (pageFaqs.length > 0) {
  schemas.push(buildFAQPageSchema(pageFaqs));
}
---

<SiloLayout seo={data.seo} silo="international-tours" currentSlug={slug} pageTitle={pageTitle}>
  {schemas.map((schema) => <SchemaBlock schema={schema} />)}

  <HeroSection heading={data.hero.heading} subheading={data.hero.subheading} image={data.hero.image} imageAlt={data.hero.imageAlt} compact />

  <QuickAnswer question={data.quickAnswer.question} answer={data.quickAnswer.answer} />

  {/* ─── Destination page ─── */}
  {destination && (
    <>
      <p class="mt-4 text-sm text-slate-500">By {destination.author.name}, {destination.author.role}</p>
      <div class="mt-6">
        {destination.overview.map((p) => <p class="mt-3 leading-relaxed text-slate-600">{p}</p>)}
      </div>

      {/* Pricing Tiers */}
      <section class="mt-10">
        <h2 class="font-heading text-xl font-semibold text-slate-900">Packages & Pricing</h2>
        <div class="mt-6 flex flex-col gap-6">
          {destination.pricingTiers.map((tier) => (
            <article class="rounded-xl border border-slate-200 p-6">
              <div class="flex flex-wrap items-start justify-between gap-3">
                <div>
                  <h3 class="font-heading text-lg font-semibold text-slate-900">{tier.name}</h3>
                  <p class="text-sm text-slate-500">{tier.duration}</p>
                </div>
                <PriceBadge priceFrom={tier.priceFrom} currency={tier.currency} />
              </div>
              {tier.highlights && tier.highlights.length > 0 && (
                <div class="mt-4"><HighlightsList highlights={tier.highlights} /></div>
              )}
              <div class="mt-4 grid gap-4 sm:grid-cols-2">
                <div>
                  <h4 class="text-sm font-medium text-slate-700">Includes</h4>
                  <ul class="mt-2 flex flex-col gap-1">
                    {tier.includes.map((item) => (
                      <li class="flex items-start gap-2 text-sm text-slate-600">
                        <span class="mt-1 text-primary" aria-hidden="true">&#10003;</span>{item}
                      </li>
                    ))}
                  </ul>
                </div>
                {tier.excludes && tier.excludes.length > 0 && (
                  <div>
                    <h4 class="text-sm font-medium text-slate-700">Excludes</h4>
                    <ul class="mt-2 flex flex-col gap-1">
                      {tier.excludes.map((item) => (
                        <li class="flex items-start gap-2 text-sm text-slate-500">
                          <span class="mt-1" aria-hidden="true">&mdash;</span>{item}
                        </li>
                      ))}
                    </ul>
                  </div>
                )}
              </div>
            </article>
          ))}
        </div>
      </section>

      {/* Itinerary Highlights */}
      <section class="mt-10">
        <h2 class="font-heading text-xl font-semibold text-slate-900">Itinerary Highlights</h2>
        <div class="mt-6 flex flex-col gap-4">
          {destination.itineraryHighlights.map((item) => (
            <div class="flex gap-4 rounded-lg border border-slate-100 p-4">
              <span class="shrink-0 font-heading text-sm font-semibold text-primary">{item.day}</span>
              <div>
                <h3 class="font-heading text-sm font-semibold text-slate-900">{item.title}</h3>
                <p class="mt-1 text-sm text-slate-600">{item.description}</p>
              </div>
            </div>
          ))}
        </div>
      </section>

      {/* Visa Info */}
      <section class="mt-10">
        <h2 class="font-heading text-xl font-semibold text-slate-900">{destination.visaInfo.heading}</h2>
        <QuickAnswer question={destination.visaInfo.quickAnswer.question} answer={destination.visaInfo.quickAnswer.answer} />
        {destination.visaInfo.body.map((p) => <p class="mt-3 text-sm leading-relaxed text-slate-600">{p}</p>)}
      </section>

      {/* Best Time to Visit */}
      <section class="mt-10">
        <h2 class="font-heading text-xl font-semibold text-slate-900">{destination.bestTimeToVisit.heading}</h2>
        <QuickAnswer question={destination.bestTimeToVisit.quickAnswer.question} answer={destination.bestTimeToVisit.quickAnswer.answer} />
        <p class="mt-3 text-sm leading-relaxed text-slate-600">{destination.bestTimeToVisit.body}</p>
      </section>

      {/* Why Book With iWay */}
      <section class="mt-10">
        <h2 class="font-heading text-xl font-semibold text-slate-900">{destination.whyBookWithIWay.heading}</h2>
        <div class="mt-6 grid gap-4 sm:grid-cols-2">
          {destination.whyBookWithIWay.reasons.map((reason) => (
            <div class="rounded-lg border border-slate-200 p-4">
              <h3 class="font-heading text-sm font-semibold text-slate-900">{reason.title}</h3>
              <p class="mt-1 text-sm text-slate-600">{reason.description}</p>
            </div>
          ))}
        </div>
      </section>
    </>
  )}

  {/* ─── Editorial page ─── */}
  {editorial && (
    <>
      <p class="mt-4 text-sm text-slate-500">By {editorial.author.name}, {editorial.author.role}</p>
      <p class="mt-4 leading-relaxed text-slate-600">{editorial.overview}</p>
      <div class="mt-10 flex flex-col gap-10">
        {editorial.sections.map((section) => (
          <section>
            <h2 class="font-heading text-xl font-semibold text-slate-900">{section.heading}</h2>
            {section.quickAnswer && <QuickAnswer question={section.quickAnswer.question} answer={section.quickAnswer.answer} />}
            {section.body.map((p) => <p class="mt-3 leading-relaxed text-slate-600">{p}</p>)}
            {section.image && (
              <img src={section.image} alt={section.imageAlt ?? ''} width="800" height="450" loading="lazy" class="mt-4 aspect-video w-full rounded-lg object-cover" />
            )}
          </section>
        ))}
      </div>
    </>
  )}

  {/* ─── FAQ page ─── */}
  {faqPage && (
    <div class="mt-10 flex flex-col gap-10">
      <p class="leading-relaxed text-slate-600">{faqPage.overview}</p>
      {faqPage.faqGroups.map((group) => (
        <section>
          <h2 class="font-heading text-xl font-semibold text-slate-900">{group.groupHeading}</h2>
          <div class="mt-4"><FAQAccordion faqs={group.faqs} /></div>
        </section>
      ))}
    </div>
  )}

  {/* FAQs for non-FAQ page types */}
  {pageFaqs.length > 0 && !faqPage && (
    <section class="mt-10">
      <h2 class="font-heading text-xl font-semibold text-slate-900">Frequently Asked Questions</h2>
      <div class="mt-4"><FAQAccordion faqs={pageFaqs} /></div>
    </section>
  )}

  <StickyFooterCTA />
</SiloLayout>
