{
  "context": "https://schema.org",
  "type": "FAQPage",
  "baseProperties": {
    "@context": "https://schema.org",
    "@type": "FAQPage",
    "mainEntity": [
      {
        "@type": "Question",
        "name": "{{questionText}}",
        "acceptedAnswer": {
          "@type": "Answer",
          "text": "{{answerText}}"
        }
      }
    ]
  }
}
