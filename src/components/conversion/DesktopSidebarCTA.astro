---
// Desktop-only CTA card in the sidebar of international destination pages.
// Sticky positioned within the sidebar column.
---

<aside class="hidden lg:block">
  <div class="sticky top-24 rounded-xl border border-primary/20 bg-primary/5 p-6">
    <h3 class="font-heading text-base font-semibold text-slate-900">Get a Custom Quote</h3>
    <p class="mt-2 text-sm leading-relaxed text-slate-600">
      Tell us your dates, group size, and preferences — our team will build a tailored itinerary within 24 hours.
    </p>
    <ul class="mt-3 flex flex-col gap-1.5 text-sm text-slate-600">
      <li class="flex items-center gap-2">
        <span class="block h-1.5 w-1.5 rounded-full bg-primary" aria-hidden="true" />
        No obligation, no spam
      </li>
      <li class="flex items-center gap-2">
        <span class="block h-1.5 w-1.5 rounded-full bg-primary" aria-hidden="true" />
        Direct flights from Trivandrum
      </li>
      <li class="flex items-center gap-2">
        <span class="block h-1.5 w-1.5 rounded-full bg-primary" aria-hidden="true" />
        Visa handling included
      </li>
    </ul>
    <a
      href="/contact"
      class="mt-5 block w-full rounded-lg bg-primary py-2.5 text-center text-sm font-semibold text-white transition-colors hover:bg-primary-dark"
    >
      Get a Free Quote
    </a>
  </div>
</aside>
