---
import type { SEOProps } from '../../utils/types';
import commonData from '../../content/common.json';

interface Props extends SEOProps {
  preloadImage?: string;
}

const { title, description, ogImage, canonicalUrl, noindex, preloadImage } = Astro.props;
const siteUrl = commonData.business.url;
---

<!-- Core Meta -->
<meta charset="utf-8" />
<meta name="viewport" content="width=device-width, initial-scale=1" />
<meta name="generator" content={Astro.generator} />

<!-- Title & Description -->
<title>{title}</title>
<meta name="description" content={description} />

{canonicalUrl && <link rel="canonical" href={canonicalUrl} />}
{noindex && <meta name="robots" content="noindex, nofollow" />}

<!-- Open Graph -->
<meta property="og:type" content="website" />
<meta property="og:title" content={title} />
<meta property="og:description" content={description} />
{ogImage && <meta property="og:image" content={`${siteUrl}${ogImage}`} />}
{ogImage && <meta property="og:image:width" content="1200" />}
{ogImage && <meta property="og:image:height" content="630" />}

<!-- Favicons -->
<link rel="icon" type="image/svg+xml" href="/favicon.svg" />
<link rel="icon" href="/favicon.ico" />

<!-- Font Preloads (Inter subset 60KB + Outfit 44KB = 104KB total) -->
<link rel="preload" href="/fonts/inter-variable.woff2" as="font" type="font/woff2" crossorigin />
<link rel="preload" href="/fonts/outfit-variable.woff2" as="font" type="font/woff2" crossorigin />

<!-- LCP Image Preload -->
{preloadImage && <link rel="preload" href={preloadImage} as="image" fetchpriority="high" />}
