---
import { footerNav } from '../../config/navigation';
---

<div>
  <h3 class="font-heading text-sm font-semibold text-slate-900">Quick Links</h3>
  <ul class="mt-4 flex flex-col gap-2">
    {footerNav.map((item) => (
      <li>
        <a href={item.url} class="text-sm text-slate-600 transition-colors hover:text-primary">
          {item.label}
        </a>
      </li>
    ))}
  </ul>
</div>
