---
import type { SiloType } from '../../utils/types';
import { siloSpokes } from '../../config/navigation';

interface Props {
  silo: SiloType;
  currentSlug?: string;
}

const { silo, currentSlug } = Astro.props;
const spokes = siloSpokes[silo];
const siloLabel = silo === 'local-tours' ? 'Local Tours' : 'International Tours';
---

<aside class="hidden lg:block" aria-label="Section navigation">
  <nav class="sticky top-24">
    <h2 class="font-heading text-sm font-semibold text-slate-900">{siloLabel}</h2>
    <ul class="mt-3 flex flex-col gap-1">
      {spokes.map((spoke) => {
        const isActive = spoke.url.endsWith(`/${currentSlug}`);
        return (
          <li>
            <a
              href={spoke.url}
              class:list={[
                'block rounded-lg px-3 py-2 text-sm transition-colors',
                isActive
                  ? 'bg-primary/10 font-medium text-primary'
                  : 'text-slate-600 hover:bg-slate-50 hover:text-primary',
              ]}
              aria-current={isActive ? 'page' : undefined}
            >
              {spoke.label}
            </a>
          </li>
        );
      })}
    </ul>
  </nav>
</aside>
