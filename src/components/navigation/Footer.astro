---
import FooterNav from './FooterNav.astro';
import FooterContact from './FooterContact.astro';
import FooterSocial from './FooterSocial.astro';
---

<footer class="border-t border-slate-200 bg-slate-50">
  <div class="mx-auto max-w-7xl px-4 py-12 sm:px-6 lg:px-8">
    <div class="grid gap-8 sm:grid-cols-2 lg:grid-cols-3">
      <FooterNav />
      <FooterContact />
      <FooterSocial />
    </div>
    <div class="mt-8 border-t border-slate-200 pt-8 text-center text-sm text-slate-500">
      <p>&copy; {new Date().getFullYear()} iWay Tourism. All rights reserved.</p>
    </div>
  </div>
</footer>
