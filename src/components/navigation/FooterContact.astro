---
import commonData from '../../content/common.json';

const { business, address } = commonData;
---

<div>
  <h3 class="font-heading text-sm font-semibold text-white">Contact</h3>
  <address class="mt-4 flex flex-col gap-2 text-sm not-italic text-teal-200">
    <p>
      <span class="block font-semibold text-white">iWay Tourism</span>
      <span class="block">Opp. Jacobs Heart Speciality Hospital,</span>
      <span class="block">Kuzhithurai Junction,</span>
    </p>
    <p>{address.addressLocality}, {address.addressRegion} {address.postalCode}</p>
    <a href={`tel:${business.phone}`} class="transition-colors hover:text-amber-400">
      {business.phone}
    </a>
    <a href={`mailto:${business.email}`} class="transition-colors hover:text-amber-400">
      {business.email}
    </a>
  </address>
</div>
