---
import type { CrossSellProps } from '../../utils/types';

interface Props extends CrossSellProps {}

const { heading, body, links } = Astro.props;
---

<aside class="rounded-xl border border-primary/20 bg-primary/5 p-6">
  <h2 class="font-heading text-lg font-semibold text-slate-900">{heading}</h2>
  <p class="mt-2 text-sm leading-relaxed text-slate-600">{body}</p>
  <ul class="mt-4 flex flex-col gap-3 sm:flex-row sm:flex-wrap">
    {links.map((link) => (
      <li>
        <a
          href={link.url}
          class="inline-flex flex-col rounded-lg border border-primary/20 bg-white px-4 py-3 transition-shadow hover:shadow-md"
        >
          <span class="text-sm font-medium text-primary">{link.label}</span>
          {link.tagline && (
            <span class="mt-0.5 text-xs text-slate-500">{link.tagline}</span>
          )}
        </a>
      </li>
    ))}
  </ul>
</aside>
