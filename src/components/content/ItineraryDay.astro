---
import type { ItineraryDayProps } from '../../utils/types';
import ItineraryStop from './ItineraryStop.astro';

interface Props extends ItineraryDayProps {}

const { dayNumber, title, description, stops, meals, overnight } = Astro.props;
---

<section id={`day-${dayNumber}`} class="scroll-mt-20">
  <div class="flex items-center gap-3">
    <span class="flex h-10 w-10 shrink-0 items-center justify-center rounded-full bg-primary text-sm font-bold text-white">
      {dayNumber}
    </span>
    <h3 class="font-heading text-lg font-semibold text-slate-900">{title}</h3>
  </div>
  <p class="mt-3 text-sm leading-relaxed text-slate-600">{description}</p>

  {stops.length > 0 && (
    <div class="mt-4 divide-y divide-slate-100 border-l-2 border-primary/20 pl-4">
      {stops.map((stop) => (
        <ItineraryStop {...stop} />
      ))}
    </div>
  )}

  {(meals || overnight) && (
    <div class="mt-4 flex flex-wrap gap-4 text-sm text-slate-500">
      {meals && (
        <span>Meals: {meals}</span>
      )}
      {overnight && (
        <span>Overnight: {overnight}</span>
      )}
    </div>
  )}
</section>
