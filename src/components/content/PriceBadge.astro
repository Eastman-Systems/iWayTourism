---
import type { PriceBadgeProps } from '../../utils/types';

interface Props extends PriceBadgeProps {}

const { priceFrom, currency = 'INR' } = Astro.props;
const formatted = new Intl.NumberFormat('en-IN', {
  style: 'currency',
  currency,
  maximumFractionDigits: 0,
}).format(priceFrom);
---

<span class="inline-block rounded-full bg-accent-light/15 px-3 py-1 text-sm font-semibold text-accent-dark">
  From {formatted}
</span>
