---
import type { TeamMemberCardProps } from '../../utils/types';
import SchemaBlock from '../schema/SchemaBlock.astro';
import { buildPersonSchema } from '../../utils/schema-builder';

interface Props extends TeamMemberCardProps {
  /**
   * 'round'    — compact card with circular avatar (default, used on About Us)
   * 'portrait' — full-bleed photo card (used on Contact page)
   */
  variant?: 'round' | 'portrait';
}

const { name, role, bio, image, imageAlt, variant = 'round' } = Astro.props;
const personSchema = buildPersonSchema({ name, role, bio, image, imageAlt });
---

{variant === 'portrait' ? (
  <!-- Portrait card: photo fills top, edge-to-edge on mobile, rounded on sm+ -->
  <article class="overflow-hidden bg-white sm:rounded-2xl sm:border sm:border-slate-200">
    {image && (
      <div class="aspect-[3/4] w-full overflow-hidden">
        <img
          src={image}
          alt={imageAlt ?? name}
          width="800"
          height="1067"
          loading="lazy"
          class="h-full w-full object-cover object-top transition-transform duration-300 hover:scale-[1.02]"
        />
      </div>
    )}
    <div class="p-5">
      <h3 class="font-heading text-lg font-semibold text-slate-900">{name}</h3>
      <p class="mt-0.5 text-sm font-medium text-primary">{role}</p>
      {bio && <p class="mt-3 text-sm leading-relaxed text-slate-600">{bio}</p>}
    </div>
  </article>
) : (
  <!-- Round card: compact with circular avatar -->
  <article class="rounded-xl border border-slate-200 bg-white p-5 text-center">
    {image && (
      <img
        src={image}
        alt={imageAlt ?? name}
        width="400"
        height="400"
        loading="lazy"
        class="mx-auto aspect-square h-24 w-24 rounded-full object-cover"
      />
    )}
    <h3 class="mt-4 font-heading text-base font-semibold text-slate-900">{name}</h3>
    <p class="text-sm text-primary">{role}</p>
    <p class="mt-2 text-sm leading-relaxed text-slate-600">{bio}</p>
  </article>
)}
<SchemaBlock schema={personSchema} />
