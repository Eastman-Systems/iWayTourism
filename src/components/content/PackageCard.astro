---
import type { PackageCardProps } from '../../utils/types';
import PriceBadge from './PriceBadge.astro';

interface Props extends PackageCardProps {
  basePath?: string;
}

const { title, slug, tagline, priceFrom, image, imageAlt, basePath = '/international-tours' } = Astro.props;
const href = `${basePath}/${slug}`;
---

<div class="@container">
  <a href={href} class="group block overflow-hidden rounded-xl border border-slate-200 bg-white transition-shadow hover:shadow-md">
    <div class="flex flex-col @md:flex-row">
      <div class="@md:w-2/5">
        <img
          src={image}
          alt={imageAlt}
          width="600"
          height="400"
          loading="lazy"
          class="aspect-3/2 w-full object-cover"
        />
      </div>
      <div class="flex flex-1 flex-col justify-between p-4 @md:p-5">
        <div>
          <h3 class="font-heading text-base font-semibold text-slate-900 group-hover:text-primary @md:text-lg">
            {title}
          </h3>
          <p class="mt-1 text-sm text-slate-600 leading-relaxed">{tagline}</p>
        </div>
        {priceFrom && (
          <div class="mt-3">
            <PriceBadge priceFrom={priceFrom} />
          </div>
        )}
      </div>
    </div>
  </a>
</div>
