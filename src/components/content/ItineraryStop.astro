---
import type { ItineraryStopProps } from '../../utils/types';

interface Props extends ItineraryStopProps {}

const { name, description, duration, tip, image, imageAlt } = Astro.props;
---

<div class="flex gap-4 py-3">
  {image && (
    <img
      src={image}
      alt={imageAlt ?? name}
      width="600"
      height="400"
      loading="lazy"
      class="hidden aspect-3/2 w-28 shrink-0 rounded-lg object-cover sm:block"
    />
  )}
  <div class="flex-1">
    <div class="flex items-baseline gap-2">
      <h4 class="font-heading text-sm font-semibold text-slate-900">{name}</h4>
      {duration && (
        <span class="text-xs text-slate-500">({duration})</span>
      )}
    </div>
    <p class="mt-1 text-sm leading-relaxed text-slate-600">{description}</p>
    {tip && (
      <p class="mt-2 rounded-md bg-accent-light/10 px-3 py-2 text-xs text-accent-dark">
        <span class="font-semibold">Tip:</span> {tip}
      </p>
    )}
  </div>
</div>
