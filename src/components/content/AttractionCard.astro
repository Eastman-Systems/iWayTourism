---
import type { AttractionCardProps } from '../../utils/types';
import HighlightsList from './HighlightsList.astro';

interface Props extends AttractionCardProps {}

const { name, description, image, imageAlt, timings, entryFee, dressCode, duration, highlights } = Astro.props;
---

<div class="@container">
  <article class="overflow-hidden rounded-xl border border-slate-200 bg-white">
    <div class="flex flex-col @lg:flex-row">
      {image && (
        <div class="@lg:w-2/5">
          <img
            src={image}
            alt={imageAlt ?? name}
            width="600"
            height="400"
            loading="lazy"
            class="aspect-3/2 w-full object-cover"
          />
        </div>
      )}
      <div class="flex flex-1 flex-col p-4 @lg:p-5">
        <h3 class="font-heading text-base font-semibold text-slate-900 @md:text-lg">{name}</h3>
        <p class="mt-2 text-sm leading-relaxed text-slate-600">{description}</p>

        <!-- Practical details grid -->
        {(timings || entryFee || dressCode || duration) && (
          <dl class="mt-3 grid grid-cols-2 gap-x-4 gap-y-2 text-sm">
            {timings && (
              <>
                <dt class="font-medium text-slate-700">Timings</dt>
                <dd class="text-slate-600">{timings}</dd>
              </>
            )}
            {entryFee && (
              <>
                <dt class="font-medium text-slate-700">Entry Fee</dt>
                <dd class="text-slate-600">{entryFee}</dd>
              </>
            )}
            {duration && (
              <>
                <dt class="font-medium text-slate-700">Duration</dt>
                <dd class="text-slate-600">{duration}</dd>
              </>
            )}
            {dressCode && (
              <>
                <dt class="font-medium text-slate-700">Dress Code</dt>
                <dd class="text-slate-600">{dressCode}</dd>
              </>
            )}
          </dl>
        )}

        {highlights && highlights.length > 0 && (
          <div class="mt-3">
            <HighlightsList highlights={highlights} />
          </div>
        )}
      </div>
    </div>
  </article>
</div>
