---
import type { TestimonialCardProps } from '../../utils/types';
import SchemaBlock from '../schema/SchemaBlock.astro';
import { buildReviewSchema } from '../../utils/schema-builder';

interface Props extends TestimonialCardProps {}

const { name, location, tripType, quote, rating, date } = Astro.props;
const reviewSchema = buildReviewSchema({ name, location, tripType, quote, rating, date });
const stars = Array.from({ length: 5 }, (_, i) => i < rating);
---

<div class="@container">
  <article class="rounded-xl border border-slate-200 bg-white p-5">
    <!-- Star rating -->
    <div class="flex gap-0.5" role="img" aria-label={`${rating} out of 5 stars`}>
      {stars.map((filled) => (
        <svg
          class:list={['h-4 w-4', filled ? 'text-accent-light' : 'text-slate-200']}
          viewBox="0 0 20 20"
          fill="currentColor"
          aria-hidden="true"
        >
          <path d="M9.049 2.927c.3-.921 1.603-.921 1.902 0l1.07 3.292a1 1 0 00.95.69h3.462c.969 0 1.371 1.24.588 1.81l-2.8 2.034a1 1 0 00-.364 1.118l1.07 3.292c.3.921-.755 1.688-1.54 1.118l-2.8-2.034a1 1 0 00-1.175 0l-2.8 2.034c-.784.57-1.838-.197-1.539-1.118l1.07-3.292a1 1 0 00-.364-1.118L2.98 8.72c-.783-.57-.38-1.81.588-1.81h3.461a1 1 0 00.951-.69l1.07-3.292z" />
        </svg>
      ))}
    </div>

    <!-- Quote -->
    <blockquote class="mt-3">
      <p class="text-sm leading-relaxed text-slate-700 @md:text-base">{quote}</p>
    </blockquote>

    <!-- Attribution -->
    <footer class="mt-4 flex items-center gap-2">
      <div>
        <p class="text-sm font-medium text-slate-900">{name}</p>
        {(location || tripType) && (
          <p class="text-xs text-slate-500">
            {[location, tripType].filter(Boolean).join(' · ')}
          </p>
        )}
      </div>
    </footer>
  </article>
</div>
<SchemaBlock schema={reviewSchema} />
