---
import type { TestimonialCardProps } from '../../utils/types';
import SchemaBlock from '../schema/SchemaBlock.astro';
import { buildReviewSchema } from '../../utils/schema-builder';

interface Props extends TestimonialCardProps {}

const { name, location, tripType, quote, rating, date } = Astro.props;
const reviewSchema = buildReviewSchema({ name, location, tripType, quote, rating, date });
const starString = '★'.repeat(rating) + '☆'.repeat(5 - rating);
---

<div class="@container">
  <article class="rounded-xl border border-slate-200 bg-white p-5">
    <!-- Star rating -->
    <div role="img" aria-label={`${rating} out of 5 stars`} class="text-base tracking-wide text-amber-400">
      <span aria-hidden="true">{starString}</span>
    </div>

    <!-- Quote -->
    <blockquote class="mt-3">
      <p class="text-sm leading-relaxed text-slate-700 @md:text-base">{quote}</p>
    </blockquote>

    <!-- Attribution -->
    <footer class="mt-4 flex items-center gap-2">
      <div>
        <p class="text-sm font-medium text-slate-900">{name}</p>
        {(location || tripType) && (
          <p class="text-xs text-slate-500">
            {[location, tripType].filter(Boolean).join(' · ')}
          </p>
        )}
      </div>
    </footer>
  </article>
</div>
<SchemaBlock schema={reviewSchema} />
