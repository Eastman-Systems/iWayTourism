---
interface Props {
  highlights: string[];
}

const { highlights } = Astro.props;
---

{highlights.length > 0 && (
  <ul class="flex flex-col gap-2">
    {highlights.map((item) => (
      <li class="flex items-start gap-2 text-sm text-slate-700">
        <span class="mt-1 block h-1.5 w-1.5 shrink-0 rounded-full bg-primary" aria-hidden="true" />
        {item}
      </li>
    ))}
  </ul>
)}
